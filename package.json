{
  "name": "opengl-renderer",
  "version": "1.0.0",
  "description": "Motor de renderizado básico con OpenGL y C++ moderno",
  "main": "src/main.cpp",
  "scripts": {
    "build": "cmake -B build && cmake --build build",
    "run": "./build/opengl_renderer",
    "clean": "rm -rf build"
  },
  "keywords": [
    "opengl",
    "rendering",
    "3d",
    "c++",
    "glfw"
  ],
  "author": "Pragma",
  "license": "MIT",
  "dependencies": {
    "glfw": "^3.3.8",
    "glad": "^0.1.36",
    "glm": "^0.9.9.8"
  },
  "devDependencies": {
    "cmake": "^3.20.0"
  }
}